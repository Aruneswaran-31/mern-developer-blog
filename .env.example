# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/devlog

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Port for the Express API
PORT=4000

# Comma-separated list of allowed browser origins (optional)
CLIENT_ORIGIN=http://localhost:3000

# Set to production to serve the built React app from the API
NODE_ENV=development
